---
// Iconos de Phosphor (set `ph` de Iconify) renderizados en build como SVG en línea.
import icons from "@iconify-json/ph/icons.json";
import { getIconData, iconToSVG, iconToHTML, replaceIDs } from "@iconify/utils";

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
const data = getIconData(icons, name);
if (!data) throw new Error(`Icono de Phosphor desconocido: ${name}`);

const svg = iconToSVG(data, { height: size, width: size });
const attrs: Record<string, string> = {
  ...svg.attributes,
  class: ["icon", className].filter(Boolean).join(" "),
  fill: "currentColor",
  focusable: "false",
};
if (label) {
  attrs.role = "img";
  attrs["aria-label"] = label;
} else {
  attrs["aria-hidden"] = "true";
}
const html = iconToHTML(replaceIDs(svg.body), attrs);
---

<Fragment set:html={html} />

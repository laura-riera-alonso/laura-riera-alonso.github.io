---
import Icon from "../Icon.astro";
import { ui } from "../../i18n/ui";
import { pathFor, type Lang } from "../../lib/i18n";

interface Props {
  lang: Lang;
  kicker: string[];
  title: string;
  lead: string;
  role: { title: string; body: string };
  facts: { k: string; v: string }[];
}

const { lang, kicker, title, lead, role, facts } = Astro.props;
const u = ui[lang];
---

<header class="container-page case-head">
  <a class="back" href={pathFor("home", lang, "#projects")}>
    <Icon name="arrow-left" size={16} />
    {u.backToProjects}
  </a>
  <p class="kicker rise" style="--d: 0">
    <span class="kicker-main">{kicker[0]}</span>
    <span class="kicker-sub">{kicker[1]}</span>
  </p>
  <h1 class="rise" style="--d: 1">{title}</h1>
  <p class="lead rise" style="--d: 2">{lead}</p>

  <div class="detail rise" style="--d: 3">
    <dl class="facts">
      {
        facts.map((f) => (
          <div class="fact">
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>
    <aside class="role">
      <h2>{role.title}</h2>
      <p>{role.body}</p>
    </aside>
  </div>
  <slot />
</header>

<style>
  .case-head {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  .back :global(.icon) {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      color: var(--ink);
    }
    .back:hover :global(.icon) {
      transform: translateX(-3px);
    }
  }
  .kicker {
    display: grid;
    gap: 0.125rem;
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
  }
  .kicker-main {
    font-weight: 600;
  }
  .kicker-sub {
    color: var(--ink-3);
  }
  h1 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(2.125rem, 1.2rem + 3.4vw, 4rem);
    font-weight: 620;
    letter-spacing: -0.034em;
    line-height: 1.06;
  }
  .lead {
    margin: 1.5rem 0 0;
    max-width: 62ch;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.3125rem);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .detail {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .facts {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }
  .fact {
    display: grid;
    gap: 0.25rem;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  dd {
    margin: 0;
    max-width: 62ch;
  }
  .role {
    align-self: start;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--bg-2);
  }
  .role h2 {
    margin: 0 0 0.375rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .role p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  @media (min-width: 768px) {
    .fact {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .detail {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 32px;
    }
    .facts {
      grid-column: 1 / span 8;
    }
    .role {
      grid-column: 9 / span 4;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 800ms var(--ease-out-expo) both;
      animation-delay: calc(var(--d, 0) * 80ms + 60ms);
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
    }
  }
</style>

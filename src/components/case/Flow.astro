---
// Flujo de un proyecto como secuencia numerada (el orden es la información).
interface Props {
  steps: { title: string; detail: string }[];
  label: string;
}

const { steps, label } = Astro.props;
---

<ol class="flow" aria-label={label}>
  {
    steps.map((step, i) => (
      <li class="step reveal" style={`--d: ${i}`}>
        <span class="n num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <span class="title">{step.title}</span>
        <span class="detail">{step.detail}</span>
      </li>
    ))
  }
</ol>

<style>
  .flow {
    display: grid;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }
  .step {
    position: relative;
    display: grid;
    gap: 0.25rem;
    align-content: start;
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .step:last-child {
    border-color: var(--accent);
  }
  .n {
    font-size: 0.75rem;
    color: var(--ink-3);
    margin-bottom: 0.375rem;
  }
  .step:last-child .n {
    color: var(--accent-ink);
  }
  .title {
    font-weight: 600;
    line-height: 1.25;
  }
  .detail {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  /* Conectores: flecha hacia abajo en móvil, hacia la derecha dentro de cada fila en escritorio. */
  .step:not(:last-child)::after {
    content: "\2193";
    position: absolute;
    left: 1.125rem;
    bottom: -24px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 20px;
    color: var(--line-strong);
  }
  @media (min-width: 640px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .step:not(:last-child)::after {
      content: "\2192";
      left: auto;
      right: -21px;
      top: 50%;
      bottom: auto;
      margin-top: -10px;
    }
    .step:nth-child(2n)::after {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .step:nth-child(2n)::after {
      display: block;
    }
    .step:nth-child(4n)::after {
      display: none;
    }
  }
</style>

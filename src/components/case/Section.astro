---
// Sección de un caso. `split`: título a la izquierda y contenido a la derecha; `wide`: título encima.
interface Props {
  id?: string;
  title: string;
  sub?: string;
  layout?: "split" | "wide";
  tint?: boolean;
}

const { id, title, sub, layout = "wide", tint = false } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section id={id} class:list={["case-section", { tint }]} aria-labelledby={headingId}>
  <div class:list={["container-page inner", layout]}>
    <header class="head reveal">
      <h2 id={headingId}>{title}</h2>
      {sub && <p>{sub}</p>}
    </header>
    <div class="content">
      <slot />
    </div>
  </div>
</section>

<style>
  .case-section {
    border-top: 1px solid var(--line);
  }
  .case-section.tint {
    background: var(--bg-2);
    border-top-color: transparent;
    --dot-ring: var(--bg-2);
  }
  .inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }
  h2 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.625rem, 1.15rem + 1.6vw, 2.375rem);
    font-weight: 600;
    letter-spacing: -0.028em;
  }
  .head p {
    margin: 0.75rem 0 0;
    max-width: 58ch;
    color: var(--ink-2);
  }
  .content {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .split {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 32px;
    }
    .split .head {
      grid-column: 1 / span 4;
      align-self: start;
      position: sticky;
      top: 6rem;
    }
    .split .content {
      grid-column: 5 / span 8;
    }
  }
</style>

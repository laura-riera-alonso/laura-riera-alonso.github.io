---
// Trayectoria: un gráfico de tiempo (formación y experiencia sobre un eje de años real) y, debajo, el detalle
// de cada etapa, las certificaciones, los idiomas y lo que hace además. El gráfico repite lo que dice el
// detalle, así que se oculta a lectores de pantalla.
import { home } from "../../i18n/home";
import { timeline, extraTimeline, certifications, languages, beyond, type TimelineItem } from "../../data/perfil";
import type { Lang } from "../../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang].path;
const items = [...timeline, ...extraTimeline];

const now = new Date();
const toYears = (ym: string | null) => {
  if (!ym) return now.getFullYear() + now.getMonth() / 12;
  const [y, m] = ym.split("-").map(Number);
  return y + (m - 1) / 12;
};
const minYear = Math.floor(Math.min(...items.map((i) => toYears(i.span.from))));
const maxYear = Math.ceil(toYears(null) + 0.01);
const x = (v: number) => ((v - minYear) / (maxYear - minYear)) * 100;
const years: number[] = [];
for (let y = minYear; y <= maxYear; y++) years.push(y);

const lanes: { kind: TimelineItem["kind"]; title: string }[] = [
  { kind: "education", title: t.education },
  { kind: "work", title: t.work },
];
const byKind = (kind: TimelineItem["kind"]) =>
  items.filter((i) => i.kind === kind).sort((a, b) => toYears(a.span.from) - toYears(b.span.from));
---

<section id="experience" class="container-page path" aria-labelledby="path-title">
  <h2 id="path-title" class="reveal">{t.title}</h2>

  <figure class="gantt reveal" aria-hidden="true">
    <figcaption class="cap">{t.chart}</figcaption>
    {
      lanes.map((lane) => (
        <div class:list={["lane", lane.kind]}>
          <p class="lane-title">
            <span class="key" />
            {lane.title}
          </p>
          {byKind(lane.kind).map((item, i) => {
            const from = x(toYears(item.span.from));
            const to = x(toYears(item.span.to));
            return (
              <div class="row">
                <span class="label">
                  <span class="short">{item.short[lang]}</span>
                  <span class="when num">{item.when[lang]}</span>
                </span>
                <span class="plot">
                  {years.map((y) => (
                    <span class="grid" style={`left: ${x(y)}%`} />
                  ))}
                  <span
                    class:list={["bar", { current: item.current }]}
                    style={`left: ${from}%; width: ${Math.max(to - from, 1)}%; --i: ${i}`}
                  />
                  {item.current && (
                    <span class="now num" style={`left: ${to}%`}>
                      {t.now}
                    </span>
                  )}
                </span>
              </div>
            );
          })}
        </div>
      ))
    }
    <div class="row axis num">
      <span class="label" />
      <span class="plot">
        {years.map((y, i) => (
          <span class:list={["tick", { odd: (years.length - 1 - i) % 2 === 1 }]} style={`left: ${x(y)}%`}>
            {y}
          </span>
        ))}
      </span>
    </div>
    {items.some((i) => i.span.approx) && <p class="note">{t.approx}</p>}
  </figure>

  <div class="detail">
    {
      lanes.map((lane) => (
        <div class:list={["col", lane.kind]}>
          <h3 class="col-title">
            <span class="key" aria-hidden="true" />
            {lane.title}
          </h3>
          <ol>
            {byKind(lane.kind)
              .slice()
              .reverse()
              .map((item, i) => (
                <li class="reveal" style={`--d: ${i}`}>
                  <p class="item-when num">{item.when[lang]}</p>
                  <h4>{item.title[lang]}</h4>
                  <p class="place">{item.place[lang]}</p>
                  <p class="body">{item.body[lang]}</p>
                </li>
              ))}
          </ol>
        </div>
      ))
    }
  </div>

  <div class="extra">
    <div class="reveal">
      <h3>{t.certifications}</h3>
      <ul class="certs">
        {
          certifications.map((c) => (
            <li>
              <span class="cert-name">{c.name[lang]}</span>
              <span class="cert-by">
                {c.by[lang]}, {c.year}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="reveal" style="--d: 1">
      <h3>{t.languages}</h3>
      <ul class="langs">
        {
          languages.map((l) => (
            <li>
              <span class="lang-name">{l.name[lang]}</span>
              <span class="lang-level">{l.level[lang]}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="reveal" style="--d: 2">
      <h3>{t.beyond}</h3>
      <ul class="beyond">
        {
          beyond.map((b) => (
            <li>
              <span class="cert-name">{b.title[lang]}</span>
              <span class="cert-by">{b.when[lang]}</span>
              <span class="beyond-body">{b.body[lang]}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .path {
    padding-block: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--line);
    --c-education: var(--ink-3);
    --c-work: var(--accent);
  }
  h2 {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.5rem);
    font-weight: 600;
  }

  /* Gráfico de tiempo */
  .gantt {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius);
    background: var(--bg-2);
  }
  .cap {
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--ink-2);
  }
  .lane + .lane {
    margin-top: 1.25rem;
  }
  .lane-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .key {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--c-education);
  }
  .work .key {
    background: var(--c-work);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
    padding-block: 0.375rem;
  }
  .label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.625rem;
    font-size: 0.875rem;
    line-height: 1.3;
  }
  .short {
    font-weight: 500;
  }
  .when {
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .plot {
    position: relative;
    height: 18px;
  }
  .grid {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 1px;
    background: var(--line);
  }
  .bar {
    position: absolute;
    top: 2px;
    height: 14px;
    border-radius: 4px;
    background: var(--c-education);
    transform-origin: left center;
  }
  .work .bar {
    background: var(--c-work);
  }
  .now {
    position: absolute;
    top: 0;
    margin-left: 6px;
    font-size: 0.75rem;
    line-height: 18px;
    color: var(--accent-ink);
  }
  .axis {
    padding-top: 0.5rem;
  }
  .axis .plot {
    height: 1rem;
  }
  .tick {
    position: absolute;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .tick:first-child {
    transform: none;
  }
  .tick:last-child {
    transform: translateX(-100%);
  }
  /* En móvil no caben todos los años: uno sí y otro no, contando desde el último para que siempre se vea. */
  @media (max-width: 639px) {
    .tick.odd {
      display: none;
    }
  }
  .note {
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .gantt.reveal .bar {
      transform: scaleX(0.04);
      transition: transform 900ms var(--ease-out-expo);
      transition-delay: calc(var(--i, 0) * 90ms + 150ms);
    }
    :global(.js) .gantt.reveal.is-in .bar {
      transform: none;
    }
  }

  /* Detalle */
  .detail {
    display: grid;
    gap: 2.5rem 48px;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .col-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  ol {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ol li {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .item-when {
    margin: 0 0 0.375rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  h4 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .place {
    margin: 0.125rem 0 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .body {
    margin: 0.5rem 0 0;
    max-width: 52ch;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  /* Certificaciones, idiomas y además */
  .extra {
    display: grid;
    gap: 2.5rem 48px;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line-strong);
  }
  .extra h3 {
    margin: 0 0 1rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .extra ul {
    display: grid;
    gap: 0.875rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .extra li {
    display: grid;
    gap: 0.125rem;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .cert-by,
  .lang-level {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  .langs li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--line);
  }
  .langs li:last-child {
    border-bottom: 0;
  }
  .beyond-body {
    margin-top: 0.25rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: center;
    }
    .label {
      display: grid;
      gap: 0;
    }
    .axis .label {
      display: block;
    }
  }
  @media (min-width: 768px) {
    .detail {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .extra {
      grid-template-columns: 1.3fr 0.8fr 1.3fr;
    }
  }
</style>

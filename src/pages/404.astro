---
import Base from "../layouts/Base.astro";
import { ui } from "../i18n/ui";
import { pathFor } from "../lib/i18n";

// GitHub Pages sirve esta página para cualquier ruta que no exista, en los dos idiomas.
const es = ui.es.notFound;
const en = ui.en.notFound;
---

<Base lang="es" page="404" title={`${es.title} | Laura Riera Alonso`} description={es.body}>
  <section class="container-page missing">
    <p class="code num">404</p>
    <h1>{es.title}</h1>
    <p>{es.body}</p>
    <a class="btn btn-primary" href={pathFor("home", "es")}>{es.back}</a>
    <div class="en" lang="en">
      <h2>{en.title}</h2>
      <p>{en.body} <a href={pathFor("home", "en")}>{en.back}</a></p>
    </div>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding-block: clamp(4rem, 12vw, 9rem);
  }
  .code {
    margin: 0;
    color: var(--accent-ink);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.3rem + 3.4vw, 4rem);
    font-weight: 620;
    letter-spacing: -0.035em;
  }
  p {
    margin: 0;
    max-width: 52ch;
    color: var(--ink-2);
  }
  .btn {
    margin-top: 0.5rem;
  }
  .en {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .en h2 {
    margin: 0 0 0.375rem;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
